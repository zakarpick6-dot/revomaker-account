{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node --disable-warning=ExperimentalWarning scripts/export-static.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/health", "destination": "/data/health.json" },
    { "source": "/category/:slug", "destination": "/category" },
    { "source": "/drop/:slug", "destination": "/drop" },
    { "source": "/admin/login", "destination": "/login" }
  ],
  "headers": [
    {
      "source": "/data/site.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/data/health.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
